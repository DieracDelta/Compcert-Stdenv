+Definition check_sequence_passthrough
+           stk' f sp pc rs rs' m' :=
+  exists pc' rs2',
+    star step tge (State stk' (transf_function f) sp pc rs' m') E0
+                  (State stk' (transf_function f) sp pc' rs2' m') /\
+    match_regs f rs rs2' /\
+    (transf_function f).(fn_code) ! pc' = f.(fn_code) ! pc.
