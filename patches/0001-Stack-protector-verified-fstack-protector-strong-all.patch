+Lemma init_regs_undef:
+  forall params args r,
+  (forall r', In r' params -> Plt r' r) ->
+  (init_regs args params) # r = Vundef.
+Proof.
+  induction params; intros. reflexivity.
+  destruct args. reflexivity. cbn.
+  destruct (peq a r).
+  { subst.
+    assert (Plt r r).
+    { apply H. left. reflexivity. }
+    mylia.
+  }
